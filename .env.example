# 默认通过 http://服务器IP:8010 直接访问网页。
DRAIQ_BIND_HOST=0.0.0.0
DRAIQ_HTTP_PORT=8010

# API 默认只允许本机访问，供宿主机反向代理使用。
DRAIQ_API_BIND_HOST=127.0.0.1
DRAIQ_API_PORT=8011

# 如果宿主机 Nginx 分别代理到 18010 / 18011，请修改上方变量为以下值。
# 这些端口是宿主机端口，容器内部始终使用 8010 / 8011。
# DRAIQ_BIND_HOST=127.0.0.1
# DRAIQ_HTTP_PORT=18010
# DRAIQ_API_BIND_HOST=127.0.0.1
# DRAIQ_API_PORT=18011
